<Window x:Class="FrozenWorld.Views.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI, Roboto, sans-serif"
        ShowInTaskbar="False">

    <Border Background="White"
            CornerRadius="16"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A"
                              Direction="270"
                              ShadowDepth="6"
                              BlurRadius="24"
                              Opacity="0.16"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Icon Container -->
            <Border x:Name="borderIcon"
                    Grid.Row="0"
                    Width="56"
                    Height="56"
                    CornerRadius="28"
                    Background="#EFF6FF"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                <TextBlock x:Name="txtIcon"
                           Text="ℹ"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2563EB"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Title -->
            <TextBlock x:Name="txtTitle"
                       Grid.Row="1"
                       Text="Notification Title"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       TextAlignment="Center"
                       Margin="0,0,0,8"/>

            <!-- Message Body -->
            <TextBlock x:Name="txtMessage"
                       Grid.Row="2"
                       Text="Notification message goes here."
                       FontSize="14"
                       Foreground="#475569"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,24"/>

            <!-- Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" x:Name="colCancel"/>
                    <ColumnDefinition Width="12" x:Name="colSpacing"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnCancel"
                        Grid.Column="0"
                        Content="Cancel"
                        Height="40"
                        Background="#F1F5F9"
                        Foreground="#475569"
                        FontWeight="SemiBold"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnConfirm"
                        Grid.Column="2"
                        Content="Confirm"
                        Height="40"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnConfirm_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

