<Window x:Class="FrozenWorld.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frozen World - Sign In"
        Height="580"
        Width="430"
        MinHeight="520"
        MinWidth="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        FontFamily="{StaticResource FontFamilyApp}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid VerticalAlignment="Center" Margin="24">
            <!-- Login Card -->
            <Border Background="{StaticResource BrushSurface}"
                    CornerRadius="16"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    Padding="28,24"
                    Effect="{StaticResource ShadowElevated}">
                <StackPanel>
                    <!-- Brand Icon & Title -->
                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="{StaticResource BrushPrimaryLight}"
                            BorderBrush="{StaticResource BrushPrimaryBorder}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                        <TextBlock Text="🍨"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Frozen World"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Sign in to your enterprise ERP dashboard"
                               FontSize="13"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,18"/>

                    <!-- Email Input -->
                    <TextBlock Text="Email Address"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="txtEmail"
                             Tag="admin@frozenworld.com"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,14"/>

                    <!-- Password Input -->
                    <TextBlock Text="Password"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="txtPassword"
                                 Margin="0,0,0,16"/>

                    <!-- Inline Error Banner -->
                    <Border x:Name="borderError"
                            Background="{StaticResource BrushDangerLight}"
                            BorderBrush="{StaticResource BrushDangerBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚠ "
                                       Foreground="{StaticResource BrushDanger}"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="txtError"
                                       Foreground="{StaticResource BrushDanger}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Sign In Button (Always guaranteed visible) -->
                    <Button x:Name="btnLogin"
                            Content="Sign In to Account"
                            Height="44"
                            Visibility="Visible"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnLogin_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>